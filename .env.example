# Everything is optional: with no keys the app runs in demo mode (embedded DB, in-app outbox,
# .ics calendar feed, mock Luma/Meetup, mock checkout, reference supplier prices).

# --- Core
APP_URL=http://localhost:3000            # public URL; used in email links and the calendar feed
APP_SECRET=change-me                     # signs faculty approval links
DATABASE_URL=                            # Postgres (e.g. Supabase). Empty = embedded PGlite in .data/
CRON_SECRET=                             # Vercel Cron bearer secret for /api/cron/daily
# DEMO_TODAY=2026-10-11                  # pretend "today" for rehearsals
# AGENT_STEP_DELAY_MS=350                # pause between trace steps so the live trace is watchable

# --- Email: pick one. Outlook via Microsoft Graph (app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=                            # mailbox to send from, e.g. society@imail.sunway.edu.my
# ...or SMTP (Outlook: smtp.office365.com:587; Gmail: smtp.gmail.com:587 with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ...or Resend
RESEND_API_KEY=
RESEND_FROM=
# Demo safety: send every email to these team test inboxes instead of the real recipient
EMAIL_REDIRECT_TO=
NOTIFY_APPROVERS_BY_EMAIL=0              # 1 = also email approvers when something is blocked

# --- Google Calendar: service account (share the calendar with its email) or OAuth refresh token
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Luma (Luma Plus) / Meetup (Pro)
LUMA_API_KEY=
MEETUP_ACCESS_TOKEN=
MEETUP_GROUP_URLNAME=

# --- Payments (vendor deposits) — use TEST keys only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Nano Banana (Gemini image model) — optional; WorkBuddy normally generates images with its own integration
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Weather (Open-Meteo, no key) — venue coordinates
VENUE_LAT=3.0675
VENUE_LON=101.6036
