# Copy to .env.local for development. In production set these in your host (see docs/DEPLOYMENT.md).

# --- Core (required in production)
APP_URL=http://localhost:3000            # public URL: links in emails, OAuth issuer
APP_SECRET=                              # 32+ random chars: openssl rand -base64 48
DATABASE_URL=                            # Postgres (pooled URL on serverless). Empty in dev = embedded PGlite in .data/
CRON_SECRET=                             # Bearer secret for /api/cron/daily (Vercel Cron sends it)
BLOB_READ_WRITE_TOKEN=                   # private Vercel Blob store for posters/videos. Empty in dev = stored in the database
# DATABASE_POOL_MAX=3                    # connections per server instance
# PLATFORM_ADMIN_EMAILS=you@example.com  # may maintain any university's SOP (comma-separated)

# --- Sign-in
AUTH_GOOGLE_ID=                          # Google OAuth client (redirect URI: <APP_URL>/auth/google/callback)
AUTH_GOOGLE_SECRET=

# --- Email: sign-in links, invites and event emails. Pick one.
# Without one, development prints sign-in links to the terminal and event emails stay in the in-app outbox.
RESEND_API_KEY=
RESEND_FROM=                             # e.g. Movents <hello@your-domain.com>
# ...or SMTP (Outlook: smtp.office365.com:587; Gmail: smtp.gmail.com:587 with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ...or Microsoft Graph (app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# Staging only: send every event email to these test inboxes instead of the real recipient
# EMAIL_REDIRECT_TO=
NOTIFY_APPROVERS_BY_EMAIL=0              # 1 = also email approvers when something is waiting for them

# --- Google Calendar (timeline milestones): service account (share the calendar with it) or OAuth refresh token
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Event pages: Luma (Luma Plus) / Meetup (Pro). Without them events use the Movents registration page.
LUMA_API_KEY=
MEETUP_ACCESS_TOKEN=
MEETUP_GROUP_URLNAME=

# --- Supplier deposits (Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                   # webhook endpoint: <APP_URL>/api/payments/webhook

# --- Images generated on the server (optional; AI assistants can generate and attach their own)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Weather fallback when a university has no coordinates
# VENUE_LAT=3.139
# VENUE_LON=101.6869

# --- Development only
# DEMO_TODAY=2026-10-11                  # pretend "today" (ignored in production)
# AGENT_STEP_DELAY_MS=350                # slow the live trace down for a walkthrough
# PGLITE_DIR=.data/pglite
